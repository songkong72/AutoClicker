{
  "rules": {
    ".read": false,
    ".write": false,
    "rallyRooms": {
      ".read": "auth != null",
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && $room.length >= 1 && $room.length <= 40 && (root.child('owners').child(auth.uid).exists() || (root.child('admins').child(auth.uid).exists() && (!root.child('admins').child(auth.uid).child('group').exists() || $room.beginsWith(root.child('admins').child(auth.uid).child('group').val() + '-'))))",
        "teams": {
          "$i": {
            ".validate": "$i.matches(/^[0-9]{1,2}$/)",
            "id": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 30"
            },
            "leaderName": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "marchSec": {
              ".write": "auth != null && data.parent().exists()",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3600"
            },
            "excluded": {
              ".validate": "newData.isBoolean()"
            },
            "adminAdjustMs": {
              ".validate": "newData.isNumber() && newData.val() >= -5000 && newData.val() <= 5000"
            },
            "leaderId": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "prepSec": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3600"
        },
        "waitSec": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3600"
        },
        "run": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Z_]{1,16}$/)"
        },
        "startSeq": {
          ".validate": "newData.isNumber()"
        },
        "lastBy": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        },
        "lastAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "rallyMembers": {
      ".read": "auth != null && root.child('owners').child(auth.uid).exists()",
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && $room.length >= 1 && $room.length <= 40 && (root.child('rallyRooms').child($room).exists() || root.child('owners').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())",
        "$id": {
          ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,40}$/)",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "owners": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    },
    "admins": {
      ".read": "auth != null && (root.child('owners').child(auth.uid).exists() || (root.child('admins').child(auth.uid).child('rep').val() == true && query.orderByChild == 'group' && query.equalTo == root.child('admins').child(auth.uid).child('group').val()))",
      ".indexOn": [
        "group"
      ],
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && (root.child('owners').child(auth.uid).exists() || (auth.uid == $uid && !data.exists() && newData.child('code').exists() && root.child('adminCodes').child(newData.child('code').val()).child('usedBy').val() == auth.uid && newData.child('group').val() == root.child('adminCodes').child(newData.child('code').val()).child('group').val() && newData.child('rep').val() == root.child('adminCodes').child(newData.child('code').val()).child('rep').val()) || (root.child('admins').child(auth.uid).child('rep').val() == true && auth.uid != $uid && data.exists() && !newData.exists() && data.child('group').val() == root.child('admins').child(auth.uid).child('group').val() && data.child('rep').val() != true))",
        ".validate": "newData.hasChild('registeredAt')",
        "code": {
          ".validate": "newData.isString() && newData.val().matches(/^AD-[2-9A-HJ-NP-Z]{8}$/)"
        },
        "registeredAt": {
          ".validate": "newData.isNumber()"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
        },
        "lastSeen": {
          ".write": "auth != null && auth.uid == $uid && data.parent().exists()",
          ".validate": "newData.isNumber()"
        },
        "appVersion": {
          ".write": "auth != null && auth.uid == $uid && data.parent().exists()",
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "group": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 15"
        },
        "rep": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "adminCodes": {
      ".read": "auth != null && (root.child('owners').child(auth.uid).exists() || (root.child('admins').child(auth.uid).child('rep').val() == true && query.orderByChild == 'by' && query.equalTo == auth.uid))",
      ".indexOn": [
        "by"
      ],
      "$code": {
        ".read": "auth != null && data.child('usedBy').val() == auth.uid",
        ".write": "auth != null && (root.child('owners').child(auth.uid).exists() || (root.child('admins').child(auth.uid).child('rep').val() == true && !data.exists() && newData.child('by').val() == auth.uid && newData.child('group').val() == root.child('admins').child(auth.uid).child('group').val() && !newData.child('rep').exists() && !newData.child('usedBy').exists()) || (root.child('admins').child(auth.uid).child('rep').val() == true && data.exists() && !newData.exists() && data.child('by').val() == auth.uid))",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "expiresAt": {
          ".validate": "newData.isNumber()"
        },
        "usedBy": {
          ".write": "auth != null && !data.exists() && newData.val() == auth.uid && root.child('adminCodes').child($code).child('expiresAt').val() > now",
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "group": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 15"
        },
        "rep": {
          ".validate": "newData.isBoolean()"
        },
        "by": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "repRequests": {
      ".read": "auth != null && root.child('owners').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('owners').child(auth.uid).exists())",
        ".write": "auth != null && (root.child('owners').child(auth.uid).exists() || (auth.uid == $uid && (!newData.exists() || (newData.child('status').val() == 'pending' && !root.child('admins').child(auth.uid).exists()))))",
        ".validate": "newData.hasChildren(['group', 'name', 'createdAt', 'status'])",
        "group": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 15"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
        },
        "note": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "status": {
          ".validate": "newData.val() == 'pending' || newData.val() == 'rejected'"
        },
        "reason": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
