<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvVerifyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒 회원 전용 초대코드 인증"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="18dp"
        android:text="본 앱은 인가된 회원 전용입니다.\n발급받으신 이메일(또는 ID)과 전용 초대코드를 입력해 주세요."
        android:textColor="#94A3B8"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="회원 이메일 또는 식별 ID"
        android:textColor="#CBD5E1"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etVerifyUserId"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_list_container"
        android:hint="예: user@gmail.com"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="14dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#64748B"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="초대코드 (6자리)"
        android:textColor="#CBD5E1"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etVerifyCode"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="22dp"
        android:background="@drawable/bg_list_container"
        android:hint="예: AC-8F3K9A"
        android:inputType="textCapCharacters"
        android:paddingHorizontal="14dp"
        android:textColor="#38BDF8"
        android:textColorHint="#64748B"
        android:textSize="15sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnSubmitVerification"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="#3B82F6"
        android:text="인증 완료 및 시작하기"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnOpenAdminLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:padding="8dp"
        android:text="👑 관리자 로그인 (코드 발급 및 관리)"
        android:textColor="#64748B"
        android:textSize="12sp" />

</LinearLayout>
