<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

  <!-- 머리 줄: 점(편집 중엔 체크박스) · 이름 · 행군시간(+몇 초 늦게) · 상태/펼침 · 남은 시간 -->
  <LinearLayout
    android:id="@+id/rowHead"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal">

    <!-- 평소엔 접속 점, 편집 중엔 체크박스(참여/제외) -->
    <ImageView
        android:id="@+id/rowDot"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:scaleType="center"
        android:src="@drawable/ic_rp_dot" />

    <LinearLayout
        android:id="@+id/rowNameWrap"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rowName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:minHeight="40dp"
            android:textColor="#F1F5F9"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/rowMe"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_badge_me"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="나"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 펼친 줄에서만: 군단 이름 칸 · 맡은 사람 칸(눌러서 배정) -->
    <TextView
        android:id="@+id/rowTeamBox"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:background="@drawable/bg_stepper"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:minWidth="52dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#F1F5F9"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/rowLeaderBox"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_stepper"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#F1F5F9"
        android:textSize="15sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/rowMarch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:gravity="end"
        android:textColor="#F1F5F9"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rowStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="center"
        android:minHeight="24dp"
        android:textColor="#CBD5E1"
        android:textSize="12sp" />

    <ImageView
        android:id="@+id/rowChevron"
        android:layout_width="32dp"
        android:layout_height="44dp"
        android:scaleType="center"
        android:src="@drawable/ic_rp_chevron"
        android:visibility="gone" />

    <TextView
        android:id="@+id/rowDel"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:gravity="center"
        android:minWidth="44dp"
        android:textColor="#F87171"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/rowRemain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:minWidth="56dp"
        android:textColor="#FBBF24"
        android:textSize="22sp"
        android:textStyle="bold" />
  </LinearLayout>

  <!-- 펼침: 행군 시간 · 보정 · 삭제. 편집 모드에서 줄을 펼쳤을 때, 집결장은 내 군단 줄에서 보인다 -->
  <LinearLayout
    android:id="@+id/rowExpand"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="44dp"
    android:orientation="vertical"
    android:paddingBottom="8dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="행군 시간"
                android:textColor="#8190A8"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_stepper"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/rowMinus"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="#A9B4C7"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/rowMarchVal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="#F1F5F9"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rowPlus"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#A9B4C7"
                    android:textSize="22sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowAdjCol"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="보정"
                android:textColor="#8190A8"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_stepper"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/rowAdjMinus"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="#A9B4C7"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/rowAdjVal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="#F1F5F9"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rowAdjPlus"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#A9B4C7"
                    android:textSize="22sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
  </LinearLayout>

  <com.sejun.autoclicker.RallyTimelineBar
    android:id="@+id/rowBar"
    android:layout_width="match_parent"
    android:layout_height="8dp"
    android:layout_marginStart="44dp"
    android:layout_marginEnd="4dp"
    android:layout_marginTop="2dp" />
</LinearLayout>
