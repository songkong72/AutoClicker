<?xml version="1.0" encoding="utf-8"?>
<com.sejun.autoclicker.RallyDragLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="312dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rally_panel"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 상단: 연결 상태 + 최소화 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rallyTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="집결"
            android:textColor="#F8FAFC"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rallyEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="✎"
            android:textColor="#94A3B8"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/rallyMinimize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="—"
            android:textColor="#94A3B8"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/rallyClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:padding="6dp"
            android:text="✕"
            android:textColor="#94A3B8"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 히어로: 큰 카운트다운 -->
    <TextView
        android:id="@+id/rallyHeroLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textColor="#CBD5E1"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/rallyHeroTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="--:--"
        android:textColor="#FFFFFF"
        android:textSize="40sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rallyHeroSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#94A3B8"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/phaseRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/phase1" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="대기" android:textSize="11sp" />
        <TextView android:id="@+id/phase2" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="집결" android:textSize="11sp" />
        <TextView android:id="@+id/phase3" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="행군" android:textSize="11sp" />
        <TextView android:id="@+id/phase4" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="도착" android:textSize="11sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/rallyHeroProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="1000" />

    <!-- 경고 -->
    <TextView
        android:id="@+id/rallyWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingVertical="4dp"
        android:textColor="#FBBF24"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 팀 줄 -->
    <!-- 군단 목록 머리글: 숫자의 뜻을 한 번만 적는다 -->
    <LinearLayout
        android:id="@+id/rallyRowsHead"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/rallyRowsHeadLeft"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="군단"
            android:textColor="#64748B"
            android:textSize="10sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="숫자 = 행군시간 · 그 아래 = 클릭 순서"
            android:textColor="#64748B"
            android:textSize="10sp" />
    </LinearLayout>

    <com.sejun.autoclicker.MaxHeightScrollView
        android:id="@+id/rallyRowsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/rallyRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </com.sejun.autoclicker.MaxHeightScrollView>

    <LinearLayout
        android:id="@+id/rallySettingsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/setPrep"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_chip_normal"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="#93C5FD"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="집결 대기"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/setWait3"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_normal"
            android:gravity="center"
            android:text="3분"
            android:textColor="#CBD5E1"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/setWait5"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_normal"
            android:gravity="center"
            android:text="5분"
            android:textColor="#CBD5E1"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/setWait10"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_normal"
            android:gravity="center"
            android:text="10분"
            android:textColor="#CBD5E1"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/rallyAddTeam"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_chip_normal"
        android:gravity="center"
        android:text="+ 군단 추가"
        android:textColor="#93C5FD"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/devToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:padding="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="내 기기 ▾"
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/devSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

    <!-- 현재 방. 눌러서 다른 방 번호를 입력하면 앱을 열지 않고 바로 옮겨간다 -->
    <TextView
        android:id="@+id/devRoom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingVertical="6dp"
        android:textColor="#E2E8F0"
        android:textSize="13sp" />

    <!-- 내 캐릭터명: 관리자가 군단을 배정할 때 명단에 이 이름으로 보인다 -->
    <TextView
        android:id="@+id/devCharName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingVertical="6dp"
        android:textColor="#E2E8F0"
        android:textSize="13sp" />

    <!-- 내 기기: 클릭 위치와 ms 보정 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="클릭 보정 (숫자를 눌러 입력)"
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <!-- 한 줄로: −0.5초 · 현재 값(눌러서 직접 입력) · +0.5초 · 위치 저장 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/devMinus500"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_normal"
            android:gravity="center"
            android:text="−0.5초"
            android:textColor="#93C5FD"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/devMs"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="64dp"
            android:gravity="center"
            android:textColor="#F1F5F9"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/devPlus500"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_normal"
            android:gravity="center"
            android:text="+0.5초"
            android:textColor="#93C5FD"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/devSavePos"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip_normal"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:maxLines="1"
            android:text="위치 저장"
            android:textColor="#E2E8F0"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/devPosStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#64748B"
        android:textSize="11sp" />

    </LinearLayout>

    <!-- 관리자 버튼 -->
    <LinearLayout
        android:id="@+id/rallyAdminBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/rallyBtnStart"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_primary"
            android:gravity="center"
            android:text="집결 시작"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rallyBtnStop"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_danger_outline"
            android:gravity="center"
            android:text="집결 취소"
            android:textColor="#F87171"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/rallyBlockedReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#F87171"
        android:textSize="12sp"
        android:visibility="gone" />
</com.sejun.autoclicker.RallyDragLayout>
