<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="380dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rally_panel"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 상단: 연결 상태 + 최소화 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rallyTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="집결"
            android:textColor="#F8FAFC"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rallyMinimize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="—"
            android:textColor="#94A3B8"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 히어로: 큰 카운트다운 -->
    <TextView
        android:id="@+id/rallyHeroLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="#CBD5E1"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/rallyHeroTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="--:--"
        android:textColor="#FFFFFF"
        android:textSize="56sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rallyHeroSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/phase1" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="대기" android:textSize="12sp" />
        <TextView android:id="@+id/phase2" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="집결" android:textSize="12sp" />
        <TextView android:id="@+id/phase3" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="행군" android:textSize="12sp" />
        <TextView android:id="@+id/phase4" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="도착" android:textSize="12sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/rallyHeroProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="1000" />

    <!-- 경고 -->
    <TextView
        android:id="@+id/rallyWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FBBF24"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 팀 줄 -->
    <LinearLayout
        android:id="@+id/rallyRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/rallyAddTeam"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_chip_normal"
        android:gravity="center"
        android:text="+ 팀 추가"
        android:textColor="#93C5FD"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- 내 기기: 클릭 위치와 ms 보정 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="내 기기"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/devMinus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="−"
            android:textColor="#93C5FD"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/devMs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="64dp"
            android:gravity="center"
            android:textColor="#F1F5F9"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/devPlus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="+"
            android:textColor="#93C5FD"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/devSavePos"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip_normal"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="클릭 위치 저장"
            android:textColor="#E2E8F0"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/devPosStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#64748B"
        android:textSize="11sp" />

    <!-- 관리자 버튼 -->
    <LinearLayout
        android:id="@+id/rallyAdminBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/rallyBtnStart"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_primary"
            android:gravity="center"
            android:text="집결 시작"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rallyBtnStop"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_danger_outline"
            android:gravity="center"
            android:text="취소"
            android:textColor="#F87171"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/rallyBlockedReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#F87171"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
