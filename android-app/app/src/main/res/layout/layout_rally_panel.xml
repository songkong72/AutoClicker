<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="380dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_panel"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 상단: 연결 상태 + 최소화 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rallyTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="집결"
            android:textColor="#F8FAFC"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rallyMinimize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="—"
            android:textColor="#94A3B8"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 히어로: 큰 카운트다운 -->
    <TextView
        android:id="@+id/rallyHeroLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="#CBD5E1"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/rallyHeroTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="--:--"
        android:textColor="#FFFFFF"
        android:textSize="56sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rallyHeroSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/rallyHeroProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:max="1000" />

    <!-- 경고 -->
    <TextView
        android:id="@+id/rallyWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FBBF24"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 팀 줄 -->
    <LinearLayout
        android:id="@+id/rallyRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical" />

    <!-- 관리자 버튼 -->
    <LinearLayout
        android:id="@+id/rallyAdminBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/rallyBtnStart"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="집결 시작" />

        <Button
            android:id="@+id/rallyBtnStop"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="취소" />
    </LinearLayout>

    <TextView
        android:id="@+id/rallyBlockedReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#F87171"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
