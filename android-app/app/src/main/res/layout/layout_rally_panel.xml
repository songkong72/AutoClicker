<?xml version="1.0" encoding="utf-8"?>
<com.sejun.autoclicker.RallyDragLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="332dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rally_panel"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <!-- 상단: 연결 상태 점 + 이름 / 편집(완료) · 작게 · 닫기 (눌리는 칸은 모두 44dp 이상) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/rallyConnDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_conn_dot" />

        <LinearLayout
            android:id="@+id/rallyTitleCol"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rallyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="집결"
                android:textColor="#F8FAFC"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- 알약(접힌 상태)에서만: 내 군단 · 방 -->
            <TextView
                android:id="@+id/rallyMiniSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#A9B4C7"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 알약(접힌 상태)에서만 보이는 남은 시간 -->
        <TextView
            android:id="@+id/rallyMiniTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:textColor="#FBBF24"
            android:textSize="28sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/rallyEdit"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:minWidth="44dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="✎"
            android:textColor="#A9B4C7"
            android:textSize="20sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/rallyMinimize"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="작게"
            android:scaleType="center"
            android:src="@drawable/ic_rp_min" />

        <ImageView
            android:id="@+id/rallyClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="닫기"
            android:scaleType="center"
            android:src="@drawable/ic_rp_close" />
    </LinearLayout>

    <!-- 히어로: 단계 이름(알림 모양) · 큰 카운트다운 · 안내 -->
    <TextView
        android:id="@+id/rallyHeroLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textColor="#CBD5E1"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/rallyHeroTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="--:--"
        android:textColor="#FFFFFF"
        android:textSize="52sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rallyHeroSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#A9B4C7"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/phaseRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/phase1" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="대기" android:textSize="13sp" />
        <TextView android:id="@+id/phase2" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="집결" android:textSize="13sp" />
        <TextView android:id="@+id/phase3" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="행군" android:textSize="13sp" />
        <TextView android:id="@+id/phase4" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="도착" android:textSize="13sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/rallyHeroProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="1000"
        android:progressDrawable="@drawable/progress_rally" />

    <!-- 경고 -->
    <TextView
        android:id="@+id/rallyWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingVertical="4dp"
        android:textColor="#FBBF24"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- 군단 목록 머리글: 숫자의 뜻을 한 번만 적는다 -->
    <LinearLayout
        android:id="@+id/rallyRowsHead"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/rallyRowsHeadLeft"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="군단"
            android:textColor="#8190A8"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/rallyRowsHeadRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="행군 시간 · 위에서부터 차례로 클릭"
            android:textColor="#8190A8"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/rallyAddTeam"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_add_dashed"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="+ 군단 추가"
            android:textColor="#93C5FD"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 군단 목록: 화면에 남는 높이까지만 늘어나고 그보다 길면 이 안에서 스크롤된다(끝에 흐려지는 표시) -->
    <com.sejun.autoclicker.MaxHeightScrollView
        android:id="@+id/rallyRowsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fadingEdgeLength="28dp"
        android:overScrollMode="never"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/rallyRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </com.sejun.autoclicker.MaxHeightScrollView>

    <LinearLayout
        android:id="@+id/rallySettingsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="74dp"
            android:layout_height="wrap_content"
            android:text="집결 대기"
            android:textColor="#A9B4C7"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/setWait3"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_soft"
            android:gravity="center"
            android:maxLines="1"
            android:text="3분"
            android:textColor="#CBD5E1"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/setWait5"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_soft"
            android:gravity="center"
            android:maxLines="1"
            android:text="5분"
            android:textColor="#CBD5E1"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/setWait10"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_soft"
            android:gravity="center"
            android:maxLines="1"
            android:text="10분"
            android:textColor="#CBD5E1"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- 이동 준비 시간: 눌러서 초를 입력 -->
    <LinearLayout
        android:id="@+id/rallyPrepRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="74dp"
            android:layout_height="wrap_content"
            android:text="이동 준비"
            android:textColor="#A9B4C7"
            android:textSize="14sp" />

        <!-- −/+ 는 1초씩, 가운데 숫자를 누르면 직접 입력 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_soft"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/setPrepMinus"
                android:layout_width="52dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="−"
                android:textColor="#A9B4C7"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/setPrep"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#F1F5F9"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/setPrepPlus"
                android:layout_width="52dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="+"
                android:textColor="#A9B4C7"
                android:textSize="22sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 내 기기 한 줄: [내 기기 ▾] ✓ 위치 저장됨 ...... 방 1111 · 문 -->
    <LinearLayout
        android:id="@+id/devToggleRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/devToggle"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_dev_chip"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="내 기기 ▾"
            android:textColor="#F1F5F9"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/devPosBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:maxLines="1"
            android:textColor="#4ADE80"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/devSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="#A9B4C7"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 내 기기(펼침): 두 줄. [방 ›][캐릭터명 ›] / [− 보정 +][위치 저장][⋯] -->
    <LinearLayout
        android:id="@+id/devSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <!-- 현재 방. 눌러서 다른 방을 고른다 -->
            <TextView
                android:id="@+id/devRoom"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_stepper"
                android:drawableEnd="@drawable/ic_rp_chevron"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="6dp"
                android:textColor="#F1F5F9"
                android:textSize="15sp" />

            <!-- 내 캐릭터명. 눌러서 바꾼다 -->
            <TextView
                android:id="@+id/devCharName"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1.3"
                android:background="@drawable/bg_stepper"
                android:drawableEnd="@drawable/ic_rp_chevron"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="6dp"
                android:textColor="#F1F5F9"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <!-- 클릭 보정: −/+ 는 0.5초씩, 가운데 숫자를 누르면 직접 입력 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.6"
                android:background="@drawable/bg_stepper"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/devMinus500"
                    android:layout_width="30dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="#A9B4C7"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/devMs"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:lineSpacingMultiplier="0.9"
                    android:maxLines="2"
                    android:textColor="#F1F5F9"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/devPlus500"
                    android:layout_width="30dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#A9B4C7"
                    android:textSize="20sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/devSavePos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_stepper"
                android:gravity="center"
                android:maxLines="1"
                android:text="위치 저장"
                android:textColor="#93C5FD"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- 자세히: 기기 ID · 저장 위치 · 진단 -->
            <ImageView
                android:id="@+id/devMore"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_stepper"
                android:contentDescription="자세히"
                android:scaleType="center"
                android:src="@drawable/ic_rp_more" />
        </LinearLayout>

        <TextView
            android:id="@+id/devPosStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#8190A8"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 지휘관 버튼: 지금 할 수 있는 하나만 넓게 -->
    <LinearLayout
        android:id="@+id/rallyAdminBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/rallyBtnStart"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_primary"
            android:gravity="center"
            android:text="집결 시작"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rallyBtnStop"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_danger_outline"
            android:gravity="center"
            android:text="집결 취소"
            android:textColor="#F87171"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/rallyBlockedReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="#F87171"
        android:textSize="13sp"
        android:visibility="gone" />
</com.sejun.autoclicker.RallyDragLayout>
