<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floatingRoot"
    android:layout_width="46dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_capsule"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="6dp"
    android:paddingEnd="4dp"
    android:paddingBottom="6dp">

    <!-- 1. 메인 시작 / 정지 버튼 (접혀도 항상 화면에 표시) -->
    <ImageButton
        android:id="@+id/btnPlayPause"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_floating_btn_circle"
        android:contentDescription="Play or Pause"
        android:padding="8dp"
        android:src="@drawable/ic_play"
        android:tint="#22C55E" />

    <!-- 2. 접고 펼쳐지는 확장 영역 (타겟 토글, 설정, 투명도, 닫기) -->
    <LinearLayout
        android:id="@+id/collapsibleContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- 타겟 조준점 숨기기 / 보이기 토글 버튼 -->
        <ImageButton
            android:id="@+id/btnToggleTarget"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_floating_btn_circle"
            android:contentDescription="Toggle Target Visibility"
            android:padding="7dp"
            android:src="@drawable/ic_visibility_off"
            android:tint="#94A3B8" />

        <!-- 집결 동시 착탄 및 그룹 작전 설정 (🚩) 버튼 -->
        <ImageButton
            android:id="@+id/btnRally"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_floating_btn_circle"
            android:contentDescription="Open Rally Sync Settings"
            android:padding="7dp"
            android:src="@drawable/ic_rally"
            android:tint="#38BDF8" />

        <!-- 인게임 실시간 설정 팝업 (⚙️) 버튼 -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_floating_btn_circle"
            android:contentDescription="Open Settings"
            android:padding="7dp"
            android:src="@drawable/ic_settings"
            android:tint="#CBD5E1" />

        <!-- 실시간 투명도 레벨 창 (🌓) 버튼 -->
        <ImageButton
            android:id="@+id/btnOpacity"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_floating_btn_circle"
            android:contentDescription="Adjust Transparency"
            android:padding="7.5dp"
            android:src="@drawable/ic_opacity"
            android:tint="#38BDF8" />

        <!-- 오토클리커 완전 종료 (✕) 버튼 -->
        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_floating_btn_circle"
            android:contentDescription="Close Overlays"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            android:tint="#EF4444" />

    </LinearLayout>

    <!-- 3. 접기 / 펼치기 (^ / v) 토글 버튼 -->
    <ImageButton
        android:id="@+id/btnFoldToggle"
        android:layout_width="36dp"
        android:layout_height="28dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_floating_btn_circle"
        android:contentDescription="Collapse or Expand"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:src="@drawable/ic_chevron_up"
        android:tint="#CBD5E1" />

</LinearLayout>
