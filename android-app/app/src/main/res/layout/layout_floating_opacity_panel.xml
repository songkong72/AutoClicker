<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/opacityPanelRoot"
    android:layout_width="52dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_capsule"
    android:clickable="true"
    android:focusable="false"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="6dp"
    android:paddingEnd="4dp"
    android:paddingBottom="6dp">

    <!-- 패널 상단 타이틀 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="투명도"
        android:textColor="#38BDF8"
        android:textSize="9.5sp"
        android:textStyle="bold" />

    <!-- 레벨 1: 100% (선명 - 기본값) -->
    <TextView
        android:id="@+id/btnLevel100"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_chip_selected"
        android:gravity="center"
        android:text="100%"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- 레벨 2: 80% (기본/추천) -->
    <TextView
        android:id="@+id/btnLevel80"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_chip_normal"
        android:gravity="center"
        android:text="80%"
        android:textColor="#E2E8F0"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- 레벨 3: 60% (반투명) -->
    <TextView
        android:id="@+id/btnLevel60"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_chip_normal"
        android:gravity="center"
        android:text="60%"
        android:textColor="#E2E8F0"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- 레벨 4: 40% (투명) -->
    <TextView
        android:id="@+id/btnLevel40"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_chip_normal"
        android:gravity="center"
        android:text="40%"
        android:textColor="#E2E8F0"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- 레벨 5: 20% (최대 투명) -->
    <TextView
        android:id="@+id/btnLevel20"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_chip_normal"
        android:gravity="center"
        android:text="20%"
        android:textColor="#E2E8F0"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
